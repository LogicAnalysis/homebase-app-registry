{
	"id": "frigate",
	"name": "Frigate",
	"release": "0.17.1-b",
	"releaseSerial": 1712,
	"description": "Setup and manage home security cameras",
	"port": 8971,
	"portHTTPS": 8971,
	"composeURL": "https://raw.githubusercontent.com/LogicAnalysis/homebase-app-registry/refs/heads/main/apps/frigate/docker-compose.yml",
	"confURL": "https://raw.githubusercontent.com/LogicAnalysis/homebase-app-registry/refs/heads/main/apps/frigate/app.conf",
	"extraFiles": [
		"https://raw.githubusercontent.com/LogicAnalysis/homebase-app-registry/refs/heads/main/apps/frigate/config.yaml"
	],
	"scripts": {
		"preInstall": "https://raw.githubusercontent.com/LogicAnalysis/homebase-app-registry/refs/heads/main/apps/frigate/preInstall.sh"
	},
	"doc": "https://raw.githubusercontent.com/LogicAnalysis/homebase-app-registry/refs/heads/main/apps/frigate/doc.html",
	"initialized": false,
	"requirePreInstall": {
		"title": "Frigate Setup",
		"pages": [
			{
				"fields": [
					{
						"type": "warning",
						"label": "High system resource usage",
						"content": "Frigate, while great for recording, is very resource intensive when it comes to object recognition. Please limit the number of cameras and recognition image resolution/frequency in the app's settings!"
					}
				]
			},
			{
				"title": "Please enter the number of cameras you will be using",
				"fields": [
					{
						"type": "number",
						"name": "cameras",
						"label": "Cameras",
						"required": true,
						"placeholder": "Please enter number of cameras..."
					}
				]
			}
		]
	}
}