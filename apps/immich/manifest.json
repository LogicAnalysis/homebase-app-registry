{
	"id": "immich",
	"name": "Immich",
	"release": "v2.7.2",
	"description": "View and manage your photo library",
	"port": 2283,
	"composeURL": "https://raw.githubusercontent.com/LogicAnalysis/homebase-app-registry/refs/heads/main/apps/immich/docker-compose.yml",
	"extraFiles": [
		"https://raw.githubusercontent.com/LogicAnalysis/homebase-app-registry/refs/heads/main/apps/immich/.env",
		"https://raw.githubusercontent.com/LogicAnalysis/homebase-app-registry/refs/heads/main/apps/immich/hwaccel.ml.yml",
		"https://raw.githubusercontent.com/LogicAnalysis/homebase-app-registry/refs/heads/main/apps/immich/hwaccel.transcoding.yml"
	],
	"scripts": {
		"preInit": "https://raw.githubusercontent.com/LogicAnalysis/homebase-app-registry/refs/heads/main/apps/immich/preInit.sh"
	},
	"doc": "https://raw.githubusercontent.com/LogicAnalysis/homebase-app-registry/refs/heads/main/apps/immich/doc.html",
	"initialized": false,
	"requirePreInit": {
		"title": "Immich Setup",
		"pages": [
			{
				"fields": [
					{
						"type": "text",
						"name": "name",
						"label": "Name",
						"required": true,
						"placeholder": "Enter your name..."
					},
					{
						"type": "email",
						"name": "email",
						"label": "Email",
						"required": true,
						"placeholder": "Enter your email address..."
					},
					{
						"type": "password",
						"name": "password",
						"label": "Password",
						"required": true,
						"placeholder": "Enter a password...",
						"confirmPassword": true
					}
				]
			},
			{
				"fields": [
					{
						"type": "info",
						"label": "Setting up an Immich admin account",
						"content": "Immich will now be setup with your new account. Please ensure that your email and password are stored securely, and use those credentials to login on the next page."
					}
				]
			}
		]
	}
}