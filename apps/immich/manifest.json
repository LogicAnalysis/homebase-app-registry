{
	"id": "immich",
	"name": "Immich",
	"release": "v3.0.1",
	"releaseSerial": 3010,
	"description": "View and manage your photo library",
	"port": 2283,
	"portHTTPS": 2283,
	"composeURL": "https://raw.githubusercontent.com/LogicAnalysis/homebase-app-registry/refs/heads/main/apps/immich/docker-compose.yml",
	"confURL": "https://raw.githubusercontent.com/LogicAnalysis/homebase-app-registry/refs/heads/main/apps/immich/app.conf",
	"extraFiles": [
		"https://raw.githubusercontent.com/LogicAnalysis/homebase-app-registry/refs/heads/main/apps/immich/hwaccel.ml.yml",
		"https://raw.githubusercontent.com/LogicAnalysis/homebase-app-registry/refs/heads/main/apps/immich/hwaccel.transcoding.yml"
	],
	"features": {
		"storage": ["media"]
	},
	"scripts": {
		"preInit": "https://raw.githubusercontent.com/LogicAnalysis/homebase-app-registry/refs/heads/main/apps/immich/preInit.sh"
	},
	"doc": "https://raw.githubusercontent.com/LogicAnalysis/homebase-app-registry/refs/heads/main/apps/immich/doc.html",
	"initialized": false,
	"requirePreInit": {
		"title": "Immich Setup",
		"pages": [
			{
				"fields": [
					{
						"type": "text",
						"name": "name",
						"label": "Name",
						"required": true,
						"placeholder": "Enter your name..."
					},
					{
						"type": "email",
						"name": "email",
						"label": "Email",
						"required": true,
						"placeholder": "Enter your email address..."
					},
					{
						"type": "password",
						"name": "password",
						"label": "Password",
						"required": true,
						"placeholder": "Enter a password...",
						"confirmPassword": true
					}
				]
			},
			{
				"fields": [
					{
						"type": "warning",
						"label": "Setting up an Immich admin account",
						"content": "Immich will now be setup with your new account. Please ensure that your email and password are stored securely! Use those credentials to login on the next page."
					}
				]
			}
		]
	},
	"tools": [
		{
			"appID": "immich",
			"id": "immich-import-takeout",
			"name": "Import Google Takeout",
			"externalScripts": [
				"https://raw.githubusercontent.com/LogicAnalysis/homebase-app-registry/refs/heads/main/apps/immich/utils/import-takeout/entrypoint.sh"
			],
			"initialized": false,
			"preInit": {
                "showSteps": true,
                "pages": [
                    {
                        "step_title": "Locate Takeout Data",
                        "fields": [
                            {
                                "type": "text",
                                "name": "TAKEOUT_DIR",
                                "label": "Takeout Directory Path",
                                "required": true,
                                "placeholder": "/mnt/sdb1/homebase_backups/0/immich/takeout"
                            }
                        ]
                    },
					{
						"step_title": "Locate Takeout Data",
						"fields": [
							{
								"type": "warning",
								"label": "Get Immich API Key",
								"content": "Open up Immich, Go to Account Settings, API Keys, and create a new key"
							}
						]
					},
                    {
                        "step_title": "Authentication",
                        "fields": [
                            {
                                "type": "text",
                                "name": "API_KEY",
                                "label": "Immich API Key",
                                "required": true,
                                "placeholder": "it_..."
                            }
                        ],
                        "content": "You must generate an API key in the Immich web interface to assign these photos to a specific user."
                    }
                ]
            },
			"status": "/tmp/immich-import-takeout.status"
		}
	]
}